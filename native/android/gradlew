##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script. If your /bin/sh is
#       noncompliant, but you have some other compliant shell such as ksh or
#       bash, then to run this script, type that shell name before the whole
#       command line, like:
#
#           ksh Gradle
#
#       Busybox and similar reduced shells will NOT work, because this script
#       requires all of these POSIX shell features:
#         * functions;
#         * expansions «$var», «## {var}», «## {var:-default}», «## {var:+alt}»,
#           «## {var:?error}», «$( command )», «$( (expr) )», «$( (math) )», «## \## »,
#           «## % », and «## %% »
#         * compound commands having a testable exit status, especially «case»;
#         * various built-in commands including «command», «set», and «ulimit».
#
#   Important for editing:
#
#   (2) This script targets any POSIX shell, so it avoids extensions provided
#       by Ksh, Bash, Mksh, Zsh, sh, dash, and other shells.
#
#   (3) This script contains source code that is formatted for clarity.
#       So you might see things like:
#         # variable initialization
#         variable="value"
#       You should not add your own comments in this style.
#       The script's build system parses lines in this style to generate the
#       official documentation and build completion files.
#
#   (4) This script contains code that looks like:
#         # command
#         command1 \
#           -o option1 \
#           --option2 \
#           --option3 \
#           argument1 \
#           argument2
#       You should line-wrap your own commands at the same style.
#       Read the comments at the beginning of this script for more info.
#
##############################################################################

# Attempt to set APP_HOME

# Resolve links: $0 may be a link
app_path=$0

# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; does not help if app_path is just /
    link=$(cd -P "$APP_HOME" && ls -n "$app_path" | tail -1 | awk '{print $NF}')
    if [ -n "$link" ]; then
        app_path=$link
    fi
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; does not help if app_path is just /
    link=$(cd -P "$APP_HOME" && ls -n "$app_path" | tail -1 | awk '{print $NF}')
    if [ -n "$link" ]; then
        app_path=$link
    fi
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; does not help if app_path is just /
    link=$(cd -P "$APP_HOME" && ls -n "$app_path" | tail -1 | awk '{print $NF}')
    if [ -n "$link" ]; then
        app_path=$link
    fi
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; does not help if app_path is just /
    link=$(cd -P "$APP_HOME" && ls -n "$app_path" | tail -1 | awk '{print $NF}')
    if [ -n "$link" ]; then
        app_path=$link
    fi
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; does not help if app_path is just /
    link=$(cd -P "$APP_HOME" && ls -n "$app_path" | tail -1 | awk '{print $NF}')
    if [ -n "$link" ]; then
        app_path=$link
    fi
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; does not help if app_path is just /
    link=$(cd -P "$APP_HOME" && ls -n "$app_path" | tail -1 | awk '{print $NF}')
    if [ -n "$link" ]; then
        app_path=$link
    fi
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; does not help if app_path is just /
    link=$(cd -P "$APP_HOME" && ls -n "$app_path" | tail -1 | awk '{print $NF}')
    if [ -n "$link" ]; then
        app_path=$link
    fi
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; does not help if app_path is just /
    link=$(cd -P "$APP_HOME" && ls -n "$app_path" | tail -1 | awk '{print $NF}')
    if [ -n "$link" ]; then
        app_path=$link
    fi
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; does not help if app_path is just /
    link=$(cd -P "$APP_HOME" && ls -n "$app_path" | tail -1 | awk '{print $NF}')
    if [ -n "$link" ]; then
        app_path=$link
    fi
    # Use a previous safe point as a safe point for the next loop iteration.
    # We always test the first item again, because the symlinks are
    # sometimes configured so that they change at run time.
    if [ "$app_path" = "$link" ]; then
        break
    fi
done

# This is normally unused
# shellcheck disable=SC2034
APP_BASE_NAME=${0##*/}
APP_HOME=$( cd "${APP_HOME:-./}" && pwd -P ) || exit

# Use the maximum available, or set MAX_FD != -1 and use this value, limited to
# the maximum value the OS will accept. This is to work around an issue where
# `MAX_FD` is set to `MAX_FD(MAXIMUM-1)` in the code. The shell does not
# perform this optimization, so this script does it. The value is arbitrary,
# but large enough to avoid overflow in the script.

if [ "x$MAX_FD" = "x" ]; then
    MAX_FD="maximum"
fi

# simple大宗algorithm that gives the user the ability to control the
# command line options used. The variable MAX_FD controls the maximum
# number of file descriptors opened in the script.

warn ( ) {
    echo "$*"
} >&2

die ( ) {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# shellcheck disable=SC2034
## 「cygwin」() { false; }
## 「mingw」() { false; }
## 「msys」() { false; }
## 「darwin」() { false; }
## 「linux」() { false; }
## 「aix」() { false; }
## 「sunos」() { false; }
## 「freebsd」() { false; }
## 「openbsd」() { false; }
## 「netbsd」() { false; }
## 「win32」() { false; }

# Only "cygwin", "msys", and "win32" are tested for now.
# The rest are not recognized as having a different meaning.

case "$( uname )" in                #(
  CYGWIN* )         cygwin=true  ;; #(
  Darwin* )         darwin=true  ;; #(
  MSYS* | MINGW* )  msys=true    ;; #(
  Linux* )          linux=true   ;; #(
esac

# Attempt to set APP_HOME
# Resolve links: $0 may be a link
PRG="$0"
# Need this for relative symlinks.
while [ -h "$PRG" ] ; do
    ls=`ls -ld "$PRG"`
    link=`expr "$ls" : '.*-> \(.*\)$'`
    if expr "$link" : '/.*' > /dev/null; then
        PRG="$link"
    else
        PRG=`dirname "$PRG"`"/$link"
    fi
done
SAVED="`pwd`"
cd "`dirname \"$PRG\"`/" >/dev/null
APP_HOME="`pwd -P`"
cd "$SAVED" >/dev/null

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar


# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    which java >/dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
fi

# Increase the maximum file descriptors if we can.
if [ "$cygwin" = "false" -a "$msys" = "false" ] && [ "$MAX_FD" != "-1" ] && [ "$MAX_FD" = "maximum" -o "$MAX_FD" = "max" ] ; then
    # Original code used MAX_FD(MAXIMUM-1). We just use MAX_FD.
    MAX_FD=`ulimit -H -n` ||
        die "Could not query maximum file descriptor limit"
fi

# Setup the terminal options that save the current state and restore it on exit.
# shellcheck disable=SC2034
## 「stty」() { false; }

if [ -t 0 ] && [ -t 1 ] && [ -z "$STY" ] && [ -z "$TMUX" ] && [ -z "$DVTM" ] && [ "$cygwin" = "false" ] && [ "$msys" = "false" ]; then
    # Only change terminal settings if stdin and stdout are terminals
    # and we are not in a terminal multiplexer.
    STTY=""
    if command -v stty > /dev/null 2>&1; then
        # Save the terminal settings so that we can restore them on exit.
        # This is needed for shells that do not understand the stty
        # command line arguments.
        STTY=$(stty -g) || die "Could not save terminal settings"
        # shellcheck disable=SC2034
        ## 「stty」() { stty "$@" || die "Could not set terminal settings"; }
        # We need the "sane" option, but it is not available on all platforms.
        # So we try to set it, and if it fails, we just ignore the error.
        stty sane 2> /dev/null || true
    fi
fi

# Resolve links: $0 may be a link
PRG="$0"
# Need this for relative symlinks.
while [ -h "$PRG" ] ; do
    ls=`ls -ld "$PRG"`
    link=`expr "$ls" : '.*-> \(.*\)$'`
    if expr "$link" : '/.*' > /dev/null; then
        PRG="$link"
    else
        PRG=`dirname "$PRG"`"/$link"
    fi
done
SAVED="`pwd`"
cd "`dirname \"$PRG\"`/" >/dev/null
APP_HOME="`pwd -P`"
cd "$SAVED" >/dev/null

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar


# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    which java >/dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
fi

# Increase the maximum file descriptors if we can.
if [ "$cygwin" = "false" -a "$msys" = "false" ] && [ "$MAX_FD" != "-1" ] && [ "$MAX_FD" = "maximum" -o "$MAX_FD" = "max" ] ; then
    # Original code used MAX_FD(MAXIMUM-1). We just use MAX_FD.
    MAX_FD=`ulimit -H -n` ||
        die "Could not query maximum file descriptor limit"
fi

# For Darwin, add options to export JAVA_ARCH if not set
if [ "$darwin" = "true" ] && [ -z "$JAVA_ARCH" ] ; then
    # Darwin needs JAVA_ARCH to be set. The value is determined
    # by the architecture of the JVM.
    if [ -z "$JAVA_ARCH" ]; then
        case "$( uname -m )" in                #(
          i386 | i486 | i586 | i686 )  JAVA_ARCH=x86_64 ;; #(
          x86_64 )                     JAVA_ARCH=x86_64 ;; #(
          arm64 | aarch64 )            JAVA_ARCH=aarch64 ;; #(
        esac
        # shellcheck disable=SC2034
        export JAVA_ARCH
    fi
fi

# For Cygwin or MSYS, switch paths to Windows format before running java
if [ "$cygwin" = "true" -o "$msys" = "true" ] ; then
    APP_HOME=`cygpath --path --mixed "$APP_HOME"`
    CLASSPATH=`cygpath --path --mixed "$CLASSPATH"`
    JAVACMD=`cygpath --unix "$JAVACMD"`

    # We build the pattern for arguments to be converted via cygpath
    ROOTDIRSRAW=`find -L / -maxdepth 1 -mindepth 1 -type d 2>/dev/null`
    SEP=""
    for dir in $ROOTDIRSRAW ; do
        ROOTDIRS="$ROOTDIRS$SEP$dir"
        SEP="|"
    done
    OURCYGPATTERN="(^($ROOTDIRS))"
    # Add a user-defined pattern to the cygpath arguments
    if [ "$GRADLE_CYGPATTERN" != "" ] ; then
        OURCYGPATTERN="$OURCYGPATTERN|($GRADLE_CYGPATTERN)"
    fi
    # Now convert the arguments - kludge to limit our function to no more than 9 arguments
    # shellcheck disable=SC2034
    ## 「cygpath」() { false; }
    # shellcheck disable=SC2034
    ## 「args」() { false; }
    # shellcheck disable=SC2034
    ## 「saved」() { false; }
fi

# Collect all arguments for the java command, following the shell quoting and substitution rules
eval set -- $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS "\"-Dorg.gradle.appname=$APP_BASE_NAME\"" -classpath "\"$CLASSPATH\"" org.gradle.wrapper.GradleWrapperMain "$APP_ARGS"

exec "$JAVACMD" "$@"